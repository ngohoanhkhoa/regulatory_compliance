# Copy to .env and fill in. Never commit your real .env.

# --------------------------------------------------------------------------- #
# Generation — OpenCode Go (OpenAI-compatible chat/completions)
# --------------------------------------------------------------------------- #
# Get a key at https://opencode.ai/auth (subscribe to Go).
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash
# Reasoning models budget reasoning + output tokens, so keep this generous.
OPENCODE_GO_MAX_TOKENS=8192
OPENCODE_GO_TEMPERATURE=0.0
# Sent as the User-Agent on OpenCode Go requests (client identification).
OPENCODE_GO_USER_AGENT=regulatory-compliance-rag/0.1

# --------------------------------------------------------------------------- #
# Embeddings — OpenRouter
# --------------------------------------------------------------------------- #
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_EMBED_BATCH_SIZE=100
# OPENROUTER_EMBED_TIMEOUT_SEC=60

# --------------------------------------------------------------------------- #
# Auth
# --------------------------------------------------------------------------- #
# Set a strong random value: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please
JWT_ALG=HS256
JWT_TTL_MIN=720
# Bootstrap admin created on first start (only if the username is absent).
# CHANGE THE PASSWORD before any shared/production deployment.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=0000

# --------------------------------------------------------------------------- #
# App
# --------------------------------------------------------------------------- #
APP_ENV=development
# Corpus freeze date surfaced in answers and the UI.
DATA_CUTOFF_DATE=2019-08-31
# Comma-separated origins allowed to call the API during development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# --------------------------------------------------------------------------- #
# Retrieval
# --------------------------------------------------------------------------- #
DEFAULT_TOP_K=7
RERANK_CANDIDATE_K=25
RERANKER_LLM_MODEL=openai/gpt-4.1-mini
# Topics timeline: relevant chunks retrieved before de-duplicating per act.
TOPIC_TIMELINE_K=25

# --------------------------------------------------------------------------- #
# Datasets
# --------------------------------------------------------------------------- #
# Imported regulatory datasets are stored here (one folder per slug).
DATASETS_DIR=data/datasets
# Registry slug of the built-in CEPS/EURLEX regulatory dataset.
EURLEX_DATASET_SLUG=eurlex

# --------------------------------------------------------------------------- #
# Personal document library
# --------------------------------------------------------------------------- #
UPLOAD_DIR=data/uploads
USER_DOCS_COLLECTION=user_documents
MAX_UPLOAD_MB=20
USER_DOC_MAX_TOKENS=800
USER_DOC_OVERLAP_RATIO=0.15

# --------------------------------------------------------------------------- #
# Ingestion (optional overrides)
# --------------------------------------------------------------------------- #
# RAW_CSV_PATH=data/raw/EurLex_regulations_all.csv
# PROCESSED_CHUNKS_PATH=data/processed/chunks.parquet
# CHUNK_MIN_TOKENS=500
# CHUNK_MAX_TOKENS=800
# CHUNK_OVERLAP_RATIO=0.15

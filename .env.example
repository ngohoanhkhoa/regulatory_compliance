# OpenCode Go API (generation step, M4+)
# Endpoint base: https://opencode.ai/zen/go/v1  (OpenAI-compatible chat/completions)
# Get a key at https://opencode.ai/auth (subscribe to Go).
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash
# Generation request tunables
# DeepSeek V4 is a reasoning model: max_tokens must budget for reasoning +
# output tokens, so keep it generous (e.g. 8192) or answers come back empty.
OPENCODE_GO_MAX_TOKENS=8192
OPENCODE_GO_TEMPERATURE=0.0
# Sent as the User-Agent on OpenCode Go requests (client identification).
OPENCODE_GO_USER_AGENT=regulatory-compliance-rag/0.1

# OpenRouter API (embedding step, M2)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Auth (M5+)
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_TTL_MIN=720

# App
APP_ENV=development
DATA_CUTOFF_DATE=2019-08-31

# Retrieval (override defaults from src/config.py if needed)
DEFAULT_TOP_K=7
RERANK_CANDIDATE_K=25
RERANKER_LLM_MODEL=openai/gpt-4.1-mini
# Topics timeline: relevant chunks retrieved before de-duplicating per act.
TOPIC_TIMELINE_K=25

# Personal document library
UPLOAD_DIR=data/uploads
USER_DOCS_COLLECTION=user_documents
MAX_UPLOAD_MB=20
USER_DOC_MAX_TOKENS=800
USER_DOC_OVERLAP_RATIO=0.15
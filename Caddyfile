:80 {
    handle /auth/* {
        reverse_proxy backend:8000
    }
    # Only POST /chat is the API; a GET (SPA route or page reload) must serve the
    # frontend, otherwise direct-loading /chat returns a backend 405.
    @chat_post {
        method POST
        path /chat
    }
    handle @chat_post {
        reverse_proxy backend:8000
    }
    handle /query {
        reverse_proxy backend:8000
    }
    handle /acts/* {
        reverse_proxy backend:8000
    }
    handle /history {
        reverse_proxy backend:8000
    }
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /feedback {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }
    handle /docs {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:80
    }
}